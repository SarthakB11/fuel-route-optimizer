# Copy to .env and adjust. Every value below is optional and has a working default.

# Routing provider. The public OSRM demo server needs no key.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=20

# Django
DJANGO_SECRET_KEY=replace-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
LOG_LEVEL=INFO

# Domain defaults
DEFAULT_RANGE_MILES=500
DEFAULT_MPG=10
DEFAULT_CORRIDOR_MILES=12
ROUTE_PLAN_CACHE_SECONDS=900
